#!/usr/bin/env bash
# bin/start — studentene skriver: start
# Nullstiller, tar imot én prompt, kjører Claude, publiserer automatisk.

set -uo pipefail
cd "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)" || exit 1

C_R=$'\e[38;5;209m'; C_C=$'\e[38;5;80m'; C_Y=$'\e[38;5;222m'
C_G=$'\e[38;5;114m'; C_D=$'\e[2m'; C_B=$'\e[1m'; C_X=$'\e[0m'

PROJECT="bekk-beach-club-26"
SCOPE="arnes-projects-8fde6be5"

LIMIT="${BC_TIMEOUT:-240}"
MODEL="${BC_MODEL:-claude-sonnet-5}"
EFFORT="${BC_EFFORT:-medium}"

TEAM=$(git branch --show-current 2>/dev/null || echo "team-00")
NUM=${TEAM##*-}
URL="https://${PROJECT}-git-${TEAM}-${SCOPE}.vercel.app"

banner() {
  clear
  cat <<BANNER

${C_C}   ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~${C_X}
${C_Y}       B E K K   B E A C H   C L U B${C_X}
${C_C}   ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~${C_X}

${C_D}                            lag ${C_B}${NUM}${C_X}

BANNER
}

rule() { echo "${C_D}  ---------------------------------------------------${C_X}"; }

on_interrupt() {
  echo; echo
  echo "${C_Y}  Stoppet.${C_X}"
  echo "${C_D}  Ingenting gikk tapt. Skriv ${C_X}${C_B}start${C_X}${C_D} for å prøve igjen.${C_X}"
  echo
  exit 130
}
trap on_interrupt INT

# ============================================================
# Blanke ark: fjerner alt forrige gruppe gjorde.
#   BC_NO_RESET=1 start   beholder nåværende tilstand
# ============================================================
if [[ -z "${BC_NO_RESET:-}" ]]; then
  banner
  echo "${C_D}  Gjør klar en ny side...${C_X}"
  echo

  pkill -f "claude -p" 2>/dev/null

  if git fetch -q origin main 2>/dev/null; then
    git reset -q --hard origin/main 2>/dev/null
    git clean -qfd 2>/dev/null
    rm -f .prompt .shipped

    # Publiser den blanke siden, slik at forhåndsvisningen også nullstilles.
    # Tom commit gir en ny SHA, ellers bygger ikke Vercel på nytt.
    git commit -q --allow-empty -m "lag ${NUM}: nullstilt $(date +%H:%M:%S)" 2>/dev/null
    if git push -qf origin "HEAD:${TEAM}" 2>/dev/null; then
      echo "${C_D}  Forhåndsvisningen nullstilles også, det tar cirka 40 sekunder.${C_X}"
    else
      echo "${C_Y}  Fikk ikke nullstilt forhåndsvisningen, men siden her er klar.${C_X}"
    fi
  else
    echo "${C_Y}  Fikk ikke kontakt med GitHub. Bruker siden som den er.${C_X}"
    echo "${C_D}  Si fra til en av oss hvis siden ser rar ut.${C_X}"
    sleep 2
  fi
fi

# ============================================================
# Hovedløkke. Går rundt igjen bare hvis Claude ikke endret noe.
# ============================================================
while true; do

  banner
  echo "${C_Y}  ┌─────────────────────────────────────────────────────┐${C_X}"
  echo "${C_Y}  │${C_X}  ${C_B}Dere har én prompt.${C_X}                                ${C_Y}│${C_X}"
  echo "${C_Y}  │${C_X}  ${C_B}Hjelp oss å gjøre nettsiden bedre.${C_X}                 ${C_Y}│${C_X}"
  echo "${C_Y}  │${C_X}                                                     ${C_Y}│${C_X}"
  echo "${C_Y}  │${C_X}  Send prompten ved å trykke ${C_B}ENTER to ganger${C_X}.        ${C_Y}│${C_X}"
  echo "${C_Y}  │${C_X}  Etterpå tenker Sonnet 5 i maks $((LIMIT / 60)) minutter.        ${C_Y}│${C_X}"
  echo "${C_Y}  └─────────────────────────────────────────────────────┘${C_X}"
  echo

  PROMPT=""
  while true; do
    printf "${C_C}  > ${C_X}"
    IFS= read -r line </dev/tty || break

    # strip escape sequences and control characters that a paste can carry.
    # keeps tab and newline; drops ESC, DEL, bell, arrow-key junk.
    line=$(printf '%s' "$line" | tr -d '\000-\010\013\014\016-\037\177')

    if [[ -z "${line//[[:space:]]/}" ]]; then
      [[ -n "$PROMPT" ]] && break
      printf "\033[1A\033[2K"   # tom linje uten tekst: bare tegn på nytt
      continue
    fi

    PROMPT+="$line"$'\n'
  done
  PROMPT="${PROMPT%$'\n'}"

  # A paste containing many newlines leaves the rest sitting in the buffer,
  # where it would run as shell commands later. Drain it.
  # macOS ships bash 3.2, which rejects fractional -t values.
  if (( ${BASH_VERSINFO[0]:-3} >= 4 )); then
    while IFS= read -r -t 0.15 _junk </dev/tty; do :; done
  else
    for _ in 1 2 3 4 5 6 7 8; do
      IFS= read -r -t 1 _junk </dev/tty || break
    done
  fi

  if [[ -z "$PROMPT" ]]; then
    echo "${C_R}  Ingenting skrevet inn.${C_X}"; exit 1
  fi

  echo
  rule
  echo "${C_Y}  Dette er prompten deres:${C_X}"
  echo
  printf '%s\n' "$PROMPT" | sed 's/^/    /'
  echo
  rule
  printf "${C_C}  Klar til å sende til Claude? ${C_X}${C_B}[Y/n]${C_X} "
  read -r ok </dev/tty

  if [[ -n "$ok" && ! "$ok" =~ ^[JjYy]$ ]]; then
    echo "${C_D}  Avbrutt.${C_X}"
    sleep 1
    continue
  fi

  echo
  echo "${C_C}  Claude jobber. Se på forhåndsvisningen, siden endrer seg live.${C_X}"
  echo "${C_D}  Publiseres automatisk når den er ferdig (maks $((LIMIT / 60)) min).${C_X}"
  rule
  echo

  NARRATE="Du vises på en skjerm foran studenter under en workshop. \
Skriv på norsk. Før hver endring: si i én kort setning hva du skal gjøre og hvorfor. \
Når du er ferdig: oppsummer i 2-4 punkter hva du endret, og nevn én ting du valgte \
bort eller en svakhet ved løsningen. Ikke vis kode i oppsummeringen."

  if claude --help 2>/dev/null | grep -q -- '--effort'; then
    claude -p "$PROMPT" --permission-mode acceptEdits \
      --model "$MODEL" --effort "$EFFORT" \
      --append-system-prompt "$NARRATE" &
  else
    claude -p "$PROMPT" --permission-mode acceptEdits \
      --model "$MODEL" \
      --append-system-prompt "$NARRATE" &
  fi
  CPID=$!
  ( sleep "$LIMIT"; kill -TERM "$CPID" 2>/dev/null ) &
  WPID=$!
  wait "$CPID"; RC=$?
  kill "$WPID" 2>/dev/null; wait "$WPID" 2>/dev/null

  echo
  rule
  [[ $RC -eq 143 ]] && echo "${C_Y}  Tiden er ute. Publiserer det Claude rakk.${C_X}"

  if [[ -z $(git status --porcelain) ]]; then
    echo
    echo "${C_Y}  Claude endret ingen filer.${C_X}"
    echo "${C_D}  Den svarte trolig på prompten i stedet for å endre siden.${C_X}"
    echo "${C_D}  Prøv igjen, og vær tydelig. For eksempel:${C_X}"
    echo "${C_D}    \"Endre siden slik at toppen ser ut som en luksus-beachclub\"${C_X}"
    echo
    printf "${C_C}  Trykk ENTER for å skrive en ny prompt.${C_X}"
    read -r </dev/tty
    continue
  fi

  break
done

# ============================================================
# Publiser
# ============================================================
echo
echo "${C_C}  Publiserer...${C_X}"
printf '%s' "$PROMPT" > .prompt

git add -A >/dev/null 2>&1
git commit -q -m "lag ${NUM}: $(date +%H:%M:%S)" >/dev/null 2>&1

PUSH_ERR=$(git push -f origin "HEAD:${TEAM}" 2>&1)
PUSH_RC=$?

if [[ $PUSH_RC -eq 0 ]]; then
  cat <<EOF

${C_Y}${C_B}      P U B L I S E R T${C_X}

${C_D}      live om cirka 40 sekunder:${C_X}
      ${C_B}${URL}${C_X}

${C_G}      Se på storskjermen nå.${C_X}

EOF
  exit 0
fi

echo
if echo "$PUSH_ERR" | grep -qiE 'authentication|denied|403|could not read Username|invalid'; then
  echo "${C_R}  Fikk ikke publisert. Ingen tilgang til GitHub.${C_X}"
  echo "${C_D}  Tilgangsnøkkelen mangler eller er utløpt. Si fra til en av oss.${C_X}"
elif echo "$PUSH_ERR" | grep -qiE 'could not resolve|unable to access|timed out|network'; then
  echo "${C_R}  Fikk ikke publisert. Ingen nettverkstilgang.${C_X}"
  echo "${C_D}  Sjekk wifi, og skriv ${C_X}${C_B}finish${C_X}${C_D} for å prøve igjen.${C_X}"
else
  echo "${C_R}  Publisering feilet.${C_X}"
  echo "${C_D}  $(echo "$PUSH_ERR" | tail -2 | tr '\n' ' ')${C_X}"
  echo "${C_D}  Skriv ${C_X}${C_B}finish${C_X}${C_D} for å prøve igjen, eller si fra til en av oss.${C_X}"
fi
echo
echo "${C_D}  Arbeidet deres ligger lagret lokalt. Ingenting er tapt.${C_X}"
echo
exit 1
