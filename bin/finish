#!/usr/bin/env bash
# bin/finish — reserveløsning. Publiserer det som allerede ligger lokalt.
# Brukes bare hvis `start` ikke fikk pushet.

set -uo pipefail
cd "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)" || exit 1

C_R=$'\e[38;5;209m'; C_C=$'\e[38;5;80m'; C_Y=$'\e[38;5;222m'
C_G=$'\e[38;5;114m'; C_D=$'\e[2m'; C_B=$'\e[1m'; C_X=$'\e[0m'

PROJECT="bekk-beach-club-26"
SCOPE="arnes-projects-8fde6be5"

TEAM=$(git branch --show-current)
NUM=${TEAM##*-}
URL="https://${PROJECT}-git-${TEAM}-${SCOPE}.vercel.app"

echo
if [[ -z $(git status --porcelain) ]] && git diff --quiet "origin/${TEAM}" HEAD 2>/dev/null; then
  echo "${C_R}  Ingenting å publisere.${C_X} ${C_D}Skriv ${C_X}${C_B}start${C_X}${C_D} først.${C_X}"
  echo
  exit 1
fi

echo "${C_C}  Publiserer lag ${NUM}...${C_X}"

git add -A >/dev/null 2>&1
git commit -q -m "lag ${NUM}: $(date +%H:%M:%S)" >/dev/null 2>&1

if git push -qf origin "HEAD:${TEAM}" 2>/dev/null; then
  cat <<EOF

${C_Y}${C_B}      P U B L I S E R T${C_X}

${C_D}      live om cirka 40 sekunder:${C_X}
      ${C_B}${URL}${C_X}

${C_G}      Se på storskjermen nå.${C_X}

EOF
else
  echo
  echo "${C_R}  Publisering feilet. Si fra til en av oss.${C_X}"
  echo
  exit 1
fi
